# Copy to .env for local development: cp .env.example .env
# On Railway: add these as service variables (DATABASE_URL comes from the Postgres plugin).

# --- Database ---
# Local / Docker Compose uses the value in docker-compose.yml for the backend service.
# Railway: paste the Postgres plugin URL as-is (postgres://... is auto-normalized).
DATABASE_URL=postgresql+psycopg://akash:password@localhost/day15_tasks
TEST_DATABASE_URL=postgresql+psycopg://akash:password@localhost/day15_tasks_test

# --- Server ---
# Railway sets PORT automatically; leave 8000 for local Docker.
PORT=8000

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo login (replace in production)
DEMO_USER_EMAIL=test@example.com
DEMO_USER_PASSWORD=password

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Railway example (uncomment and set your deployed URLs):
# CORS_ORIGINS=https://your-frontend.up.railway.app,https://your-api.up.railway.app

# --- Logging ---
# LOG_FORMAT=json emits one JSON object per line (default). Use text for local dev.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE=day15-api
LOG_ENVIRONMENT=development
LOG_SLOW_REQUEST_MS=1000

# --- Sentry (optional) ---
# Leave empty to disable error tracking locally.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1
