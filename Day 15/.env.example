# Copy to .env in this folder, then run: alembic upgrade head

# PostgreSQL (psycopg driver for SQLAlchemy)
DATABASE_URL=postgresql+psycopg://akash:password@localhost/day15_tasks

# Used by pytest (created automatically if missing)
TEST_DATABASE_URL=postgresql+psycopg://akash:password@localhost/day15_tasks_test

# JWT signing secret (default in auth.py: "your-secret-key")
# JWT_SECRET=change-me-in-production

# Comma-separated browser origins allowed by CORS (default: Vite dev URLs)
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Demo login (hardcoded in main.py for learning)
# DEMO_USER_EMAIL=test@example.com
# DEMO_USER_PASSWORD=password
