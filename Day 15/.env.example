# Copy to .env in this folder for local backend configuration.
# Day 15 currently uses in-memory stores; these values are optional overrides.

# JWT signing secret (default in auth.py: "your-secret-key")
# JWT_SECRET=change-me-in-production

# Comma-separated browser origins allowed by CORS (default: Vite dev URLs)
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Demo login (hardcoded in main.py for learning)
# DEMO_USER_EMAIL=test@example.com
# DEMO_USER_PASSWORD=password
