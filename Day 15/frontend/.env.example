# Copy to .env for local development: cp .env.example .env
# Vite loads .env automatically. Restart dev server after changes.

# --- Local dev (default) ---
# Leave empty to use same-origin requests via the Vite proxy (/tasks, /token, /ws).
VITE_API_BASE_URL=
VITE_API_WS_HOST=

# --- Railway / split deploy (set at build time) ---
# Point to your deployed API service URL (no trailing slash).
# VITE_API_BASE_URL=https://your-api.up.railway.app
# Optional explicit WebSocket host (defaults to VITE_API_BASE_URL with ws/wss scheme).
# VITE_API_WS_HOST=wss://your-api.up.railway.app

# --- Docker Compose dev only (set in docker-compose.yml, not usually in .env) ---
# API_PROXY_TARGET=http://backend:8000

# --- Sentry (optional) ---
# Leave empty to disable error tracking locally.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
