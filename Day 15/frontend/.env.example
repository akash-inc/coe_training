# Copy to .env.local (or .env) in this folder, then restart `npm run dev`.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Optional: connect WebSockets directly to the FastAPI server instead of the Vite proxy.
# Use this if comment live updates fail in dev (EPIPE / connection drops).
# Leave unset to use the default: same host as the Vite dev server (/ws proxy).
# VITE_API_WS_HOST=ws://127.0.0.1:8000
